# Copy to .env. Never commit the filled version.
TELEGRAM_TOKEN=
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=change-me

# Lock the bot to your own Telegram user id. A bot token in the wild is a bot
# anyone can talk to, and every stranger's photo is billed to your API key.
ALLOWED_TELEGRAM_IDS=

DEFAULT_TZ=Europe/Warsaw

MODEL_PHOTO=claude-sonnet-5
MODEL_PHOTO_ESCALATE=claude-opus-5
MODEL_TEXT=claude-sonnet-5
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_PLAN=claude-opus-5

IMAGE_LONG_EDGE=896
CONFIDENCE_FLOOR=0.60
CONFIDENCE_ESCALATE=0.75
AUTO_MATCH_SIMILARITY=0.62
